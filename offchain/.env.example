# PrismSettle Agent services — environment variables (dev).
#
# Copy this file to `offchain/.env` and fill in real values. `.env` is in
# .gitignore so secrets never get committed.
#
# The LLM API key is read from the env var named by `llm.api_key_env` in
# agents.yaml. Default: OPENAI_API_KEY.
#
# SIGHUP triggers a reload of agents.yaml AND a re-read of these env vars,
# so key rotation works without restarting the agents.

# OpenAI API key (default LLM provider). Get one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-replace-me

# Anthropic API key (optional, only used if agents.yaml points to Anthropic).
ANTHROPIC_API_KEY=

# Private key used by `agent --register` to send registerAgent txns.
# Leave empty in dev unless you're actually registering against a live chain.
PRISM_REGISTER_KEY=
