# PrismSettle environment variables template.
#
# Usage:
#   cp .env.example .env
#   # fill in real values, then: docker compose up -d
#
# SECURITY:
#   - .env is in .gitignore — never commit real keys.
#   - LLM API keys are injected here, never baked into images.
#   - The offchain container reads them via env_file in docker-compose.yml.

# =============================================================================
# Database (postgres service in docker-compose.yml)
# =============================================================================
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism@2026
POSTGRES_DB=prismsettle

# =============================================================================
# Chain RPC
# =============================================================================
# Default: local anvil (dev profile). For Monad testnet, replace with:
#   PRISM_RPC_URL=https://testnet-rpc.monad.xyz
# For mainnet:
#   PRISM_RPC_URL=https://rpc.monad.xyz
PRISM_RPC_URL=http://anvil:8545

# =============================================================================
# Evaluator + Keeper signing keys (no 0x prefix)
# =============================================================================
# The Evaluator signs submitValidation txs with REGISTRY_EVALUATOR_ROLE.
# The Keeper triggers epoch aggregation + slash enforcement.
# Generate with: cast wallet new | awk '{print $NF}'
# These keys MUST be funded with MON on testnet/mainnet.
PRISM_EVALUATOR_KEY=
PRISM_KEEPER_KEY=

# =============================================================================
# LLM API keys (read by agents.yaml `llm.api_key_env` field)
# =============================================================================
# At least one must be set; agents.yaml selects which env var to read.
# dev: get from provider dashboard; prod: rotate via secret manager.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# Telegram alerts (NFR-OBS02 — optional but recommended in prod)
# =============================================================================
# Create a bot via @BotFather, get the token, then create a chat and invite
# the bot. Get chat_id via: curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# Frontend (Next.js)
# =============================================================================
# Server-side API base URL (Next.js rewrites /api/* → this target).
# In docker-compose, frontend talks to offchain over the internal network.
# For local dev outside docker, set to http://localhost:9527
NEXT_PUBLIC_API_BASE_URL=http://offchain:9527

# Monad testnet RPC for frontend wallet interactions.
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# Backend chain name for the /agent/invoke proxy (FR-M11). Must match
# web3.chains[].chain_name in prod.yaml. Defaults to "prismsettle_registry".
NEXT_PUBLIC_CHAIN_NAME=prismsettle_registry

# Contract addresses (fill after running scripts/deploy_monad_testnet.sh).
# These are read by frontend/lib/contracts.ts and MUST be set for on-chain
# write operations (registerAgent / createJob / stake / etc.).
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_JOB_CONTRACT_ADDRESS=
NEXT_PUBLIC_HOOK_CONTRACT_ADDRESS=
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=

# =============================================================================
# Monad testnet faucet (Phase 9 task 9.7 deployment)
# =============================================================================
# Reference only — no env var needed. Faucet URL is in docs/testnet-faucet.md.
# Verify balance before deploy: cast balance --rpc-url $PRISM_RPC_URL <address>
